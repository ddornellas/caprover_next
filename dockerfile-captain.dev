FROM node:24-alpine
RUN apk update && apk upgrade --no-cache && apk add --update --no-cache make gcc g++ git curl openssl openssh

RUN mkdir -p /usr/src/app
WORKDIR /usr/src/app


# Install dependencies in a cacheable layer. The workspace package manifests
# are copied before the application source so source-only changes do not
# invalidate npm ci.
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/package.json
RUN npm ci

# Build backend and Next.js application from this repository.
COPY . /usr/src/app

RUN npm run build && \
     npm cache clean --force

ENV NODE_ENV production
ENV PORT 3000
EXPOSE 3000

CMD ["node" , "./built/server.js"]
