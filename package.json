{
    "name": "caprover",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        "frontend"
    ],
    "scripts": {
        "disable-otp": "node ./built/scripts/disable-otp.js",
        "dev": "sudo 'echo' && npm run build && sudo ./dev-scripts/dev-reset-service.sh",
        "dev:next": "tsx ./src/server.ts",
        "clean": "npm run build && sudo ./dev-scripts/dev-clean-run-as-dev.sh",
        "lint": "eslint 'src/**/*.ts' && npm run frontend:lint",
        "lint-fix": "eslint --fix 'src/**/*.ts'",
        "formatter": "prettier --check './src/**/*.ts' && npm run frontend:format",
        "formatter-write": "prettier --write './src/**/*.ts' && npm run frontend:format-write",
        "build": "echo 'RECOMPILING' && npx madge --circular --extensions ts ./ && rm -rf ./built && npx tsc && npm run frontend:build && echo 'Build successful'",
        "frontend:build": "npm run build --workspace=frontend",
        "frontend:dev": "npm run dev --workspace=frontend",
        "frontend:lint": "npm run lint --workspace=frontend",
        "frontend:format": "npm run format --workspace=frontend",
        "frontend:format-write": "npm run format:write --workspace=frontend",
        "frontend:start": "npm run start --workspace=frontend",
        "frontend:typecheck": "npm run typecheck --workspace=frontend",
        "e2e": "node ./e2e/caprover-smoke.mjs",
        "e2e:install": "playwright install chromium",
        "test": "jest",
        "test:all": "npm test -- --runInBand --silent && npm run frontend:typecheck && npm run frontend:lint"
    },
    "dependencies": {
        "axios": "^1.19.0",
        "bcryptjs": "^3.0.3",
        "body-parser": "^2.3.0",
        "configstore": "^5.0.1",
        "cookie-parser": "~1.4.7",
        "cron": "^4.4.0",
        "debug": "~4.4.3",
        "dockerode": "^5.0.1",
        "ejs": "^3.1.10",
        "express": "^5.2.1",
        "fs-extra": "^11.4.0",
        "http-proxy": "^1.18.1",
        "is-valid-path": "^0.1.1",
        "js-base64": "^3.9.2",
        "jsonwebtoken": "^9.0.3",
        "moment": "^2.30.1",
        "morgan": "^1.11.0",
        "multer": "^2.2.0",
        "next": "^16.3.0",
        "on-finished": "^2.4.1",
        "prettier": "^3.9.6",
        "public-ip": "^7.0.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "recursive-readdir": "^2.2.3",
        "require-from-string": "^2.0.2",
        "serve-favicon": "~2.5.1",
        "shell-quote": "^1.10.0",
        "simple-git": "^3.36.0",
        "ssh2": "^1.17.0",
        "tar": "^7.5.22",
        "typescript": "^5.9.3",
        "uuid": "^11.1.0",
        "validator": "^13.15.35",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.62.1",
        "@types/bcryptjs": "^3.0.0",
        "@types/configstore": "^5.0.1",
        "@types/cookie-parser": "^1.4.9",
        "@types/debug": "^4.1.12",
        "@types/dockerode": "^3.3.47",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/fs-extra": "^11.0.4",
        "@types/http-proxy": "^1.17.17",
        "@types/is-valid-path": "^0.1.2",
        "@types/jest": "^30.0.0",
        "@types/js-base64": "^3.3.1",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/moment": "^2.13.0",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.0.0",
        "@types/on-finished": "^2.3.5",
        "@types/require-from-string": "^1.2.3",
        "@types/serve-favicon": "^2.5.7",
        "@types/shell-quote": "^1.7.5",
        "@types/ssh2": "^1.15.5",
        "@types/tar": "^6.1.13",
        "@types/uuid": "^10.0.0",
        "@types/validator": "^13.15.10",
        "@typescript-eslint/eslint-plugin": "^8.66.0",
        "@typescript-eslint/parser": "^8.66.0",
        "eslint": "^9.39.5",
        "globals": "^16.5.0",
        "jest": "^30.4.2",
        "madge": "^8.0.0",
        "ts-jest": "^29.4.12",
        "tsx": "^4.20.6",
        "typescript-eslint": "^8.66.0"
    }
}
